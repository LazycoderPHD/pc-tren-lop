<UserControl x:Class="OSWorkbench.ProcessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.3*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <Button x:Name="BtnRefresh" Content="Làm mới" Width="100" Height="30"
                    Click="BtnRefresh_Click"/>
            <Button x:Name="BtnStartChild" Content="Tạo tiến trình con (Notepad)" Width="220" Height="30"
                    Margin="10,0,0,0" Click="BtnStartChild_Click"/>
            <Button x:Name="BtnMakeThreads" Content="Tạo 10 Thread nền" Width="160" Height="30"
                    Margin="10,0,0,0" Click="BtnMakeThreads_Click"/>
            <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" Margin="20,0,0,0"
                       TextWrapping="Wrap" MaxWidth="400"/>
        </StackPanel>

        <DataGrid x:Name="GridProcesses" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionChanged="GridProcesses_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="80"/>
                <DataGridTextColumn Header="Tên tiến trình" Binding="{Binding ProcessName}" Width="220"/>
                <DataGridTextColumn Header="RAM (MB)" Binding="{Binding RamMB}" Width="100"/>
                <DataGridTextColumn Header="Số Thread" Binding="{Binding ThreadCount}" Width="100"/>
                <DataGridTextColumn Header="Độ ưu tiên" Binding="{Binding PriorityClassText}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Margin="0,14,0,6">
            <TextBlock Text="Thread của tiến trình đang chọn (bấm 1 dòng ở bảng trên)"
                       FontWeight="Bold" FontSize="14"/>
            <TextBlock x:Name="TxtThreadInfo" Foreground="#4A5568" Margin="0,2,0,0"/>
            <TextBlock x:Name="TxtSecurityWarning" Foreground="#9C3B22" FontWeight="Bold"
                       TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <DataGrid x:Name="GridThreads" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Thread ID" Binding="{Binding ThreadId}" Width="100"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding StateText}" Width="150"/>
                <DataGridTextColumn Header="Độ ưu tiên" Binding="{Binding PriorityText}" Width="150"/>
                <DataGridTextColumn Header="Bắt đầu lúc" Binding="{Binding StartTimeText}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>