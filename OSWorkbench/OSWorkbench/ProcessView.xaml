<UserControl x:Class="OSWorkbench.ProcessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.3*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <Button x:Name="BtnRefresh" Content="Làm mới" Width="100" Height="30" Click="BtnRefresh_Click"/>
            <Button x:Name="BtnStartChild" Content="Tạo Notepad" Width="150" Height="30" Margin="10,0,0,0" Click="BtnStartChild_Click"/>
            <Button x:Name="BtnMakeThreads" Content="Tạo 10 Thread" Width="130" Height="30" Margin="10,0,0,0" Click="BtnMakeThreads_Click"/>
            <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" Margin="15,0,0,0"/>
        </StackPanel>

        <DataGrid x:Name="GridProcesses" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="GridProcesses_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="70"/>
                <DataGridTextColumn Header="Tên" Binding="{Binding ProcessName}" Width="200"/>
                <DataGridTextColumn Header="RAM (MB)" Binding="{Binding RamMB}" Width="90"/>
                <DataGridTextColumn Header="Thread" Binding="{Binding ThreadCount}" Width="80"/>
                <DataGridTextColumn Header="Độ ưu tiên" Binding="{Binding PriorityClassText}" Width="130"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Margin="0,10,0,5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Danh sách Thread (Phần C):" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Content="Tăng ưu tiên Thread" Width="140" Height="25" Margin="15,0,0,0" Click="BtnBoostPriority_Click"/>
            </StackPanel>
            <TextBlock x:Name="TxtThreadInfo" Foreground="Gray" Margin="0,2,0,0"/>
            <TextBlock x:Name="TxtSecurityWarning" Foreground="Red" FontWeight="Bold" Visibility="Collapsed"/>
        </StackPanel>

        <DataGrid x:Name="GridThreads" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Thread ID" Binding="{Binding ThreadId}" Width="90"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding StateText}" Width="140"/>
                <DataGridTextColumn Header="Độ ưu tiên" Binding="{Binding PriorityText}" Width="140"/>
                <DataGridTextColumn Header="Bắt đầu lúc" Binding="{Binding StartTimeText}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>