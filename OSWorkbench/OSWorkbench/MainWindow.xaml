<Window x:Class="OSWorkbench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OSWorkbench"
        Title="OS Workbench — Môn Hệ Điều Hành" Height="820" Width="1000">
    <TabControl Margin="8">
        <TabItem Header="Process và Thread">
            <local:ProcessView/>
        </TabItem>

        <!-- Các module của buổi sau sẽ thêm TabItem mới ngay dưới dòng này -->
    </TabControl>
</Window>