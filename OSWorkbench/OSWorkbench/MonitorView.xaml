<UserControl x:Class="OSWorkbench.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Hàng 0: Điều khiển giám sát -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="BtnStart" Content="Bắt đầu giám sát" Width="140" Height="30" Click="BtnStart_Click"/>
            <Button x:Name="BtnStop" Content="Dừng" Width="80" Height="30" Margin="10,0,0,0" IsEnabled="False" Click="BtnStop_Click"/>
            <TextBlock Text="Ngưỡng CPU cao (%):" VerticalAlignment="Center" Margin="20,0,0,0"/>
            <TextBox x:Name="TxtThreshold" Text="50" Width="45" Margin="6,0,0,0" VerticalContentAlignment="Center"/>
            <CheckBox x:Name="ChkBusyWait" Content="Chờ kiểu bận (thí nghiệm)" VerticalAlignment="Center" Margin="20,0,0,0" Click="ChkBusyWait_Click"/>
        </StackPanel>

        <!-- Hàng 1: Nhật ký + Top CPU -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Nhật ký tiến trình (mới nhất ở trên)" Grid.Column="0" Margin="0,0,5,0">
                <DataGrid x:Name="GridEvents" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Giờ" Binding="{Binding Time}" Width="80"/>
                        <DataGridTextColumn Header="Sự kiện" Binding="{Binding Kind}" Width="80"/>
                        <DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GroupBox Header="Top CPU" Grid.Column="1" Margin="5,0,0,0">
                <DataGrid x:Name="GridCpu" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70"/>
                        <DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="%CPU" Binding="{Binding CpuPercent}" Width="70"/>
                        <DataGridTextColumn Header="Cảnh báo" Binding="{Binding Warning}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <!-- Hàng 2: Trạng thái + Phòng thí nghiệm -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="TxtMonitorStatus" Foreground="#4A5568" Text="Chưa giám sát."/>

            <Expander Header="Phòng thí nghiệm tương tranh" IsExpanded="True" Margin="0,8,0,0">
                <StackPanel Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Số thread:" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtThreads" Width="50" Margin="6,0,0,0" VerticalContentAlignment="Center"/>
                        <TextBlock Text="Số lần cộng mỗi thread:" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        <TextBox x:Name="TxtIncrements" Text="1000000" Width="90" Margin="6,0,0,0" VerticalContentAlignment="Center"/>
                        <TextBlock Text="Cách cộng:" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        <ComboBox x:Name="CmbMethod" Width="130" Margin="6,0,0,0" SelectedIndex="0">
                            <ComboBoxItem Content="Không khóa"/>
                            <ComboBoxItem Content="Cờ tự chế"/>
                            <ComboBoxItem Content="lock"/>
                            <ComboBoxItem Content="Interlocked"/>
                        </ComboBox>
                        <CheckBox x:Name="ChkWiden" Content="Phóng đại khe hở" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="BtnRace" Content="Chạy" Width="80" Height="28" Click="BtnRace_Click"/>
                        <Button x:Name="BtnRace5" Content="Chạy 5 lần" Width="100" Height="28" Margin="10,0,0,0" Click="BtnRace5_Click"/>
                        <Button x:Name="BtnClearRace" Content="Xóa bảng" Width="90" Height="28" Margin="10,0,0,0" Click="BtnClearRace_Click"/>
                        <TextBlock x:Name="TxtRaceStatus" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </StackPanel>

                    <DataGrid x:Name="GridRace" Height="170" Margin="0,8,0,0" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Cách" Binding="{Binding Method}" Width="100"/>
                            <DataGridTextColumn Header="Thread" Binding="{Binding Threads}" Width="60"/>
                            <DataGridTextColumn Header="Lần cộng" Binding="{Binding Increments}" Width="90"/>
                            <DataGridTextColumn Header="Mong đợi" Binding="{Binding Expected}" Width="100"/>
                            <DataGridTextColumn Header="Thực tế" Binding="{Binding Actual}" Width="100"/>
                            <DataGridTextColumn Header="Bị mất" Binding="{Binding Lost}" Width="90"/>
                            <DataGridTextColumn Header="Thời gian (ms)" Binding="{Binding TimeMs}" Width="100"/>
                            <DataGridTextColumn Header="CPU đã tiêu (ms)" Binding="{Binding CpuMs}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Expander>
        </StackPanel>
    </Grid>
</UserControl>