@using TaskBoard.Models
@using TaskBoard.Helpers
@model TaskBoard.Models.ViewModels.TaskDetailsViewModel
@{
    ViewBag.Title = Model.Task.Title;
}

<div class="page-title-row">
    <div>
        <h2>@Model.Task.Title</h2>
        <p class="text-muted">
            Dự án: @Html.ActionLink(Model.ProjectName, "Details", "Projects", new { id = Model.ProjectId }, null)
            | Cột: @Model.Task.BoardColumn.Title
        </p>
    </div>
    <div class="page-actions">
        @Html.ActionLink("Sửa thẻ", "Edit", new { id = Model.Task.TaskId }, new { @class = "btn btn-default" })
        @if (Model.CanDelete)
        {
            using (Html.BeginForm("Delete", "Tasks", new { id = Model.Task.TaskId }, FormMethod.Post, new { @class = "inline-form", onsubmit = "return confirm('Xóa thẻ này?');" }))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">Xóa thẻ</button>
            }
        }
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="panel panel-default">
            <div class="panel-body">
                @if (string.IsNullOrWhiteSpace(Model.Task.Description))
                {
                    <p class="text-muted">Thẻ này chưa có mô tả.</p>
                }
                else
                {
                    <div class="pre-line">@Model.Task.Description</div>
                }
            </div>
        </div>

        <h4>Bình luận</h4>
        @if (Model.Comments.Count == 0)
        {
            <p class="text-muted">Chưa có bình luận nào.</p>
        }
        else
        {
            <ul class="plain-list comment-list">
                @foreach (Comment comment in Model.Comments)
                {
                    <li>
                        <div><strong>@comment.User.FullName</strong> <span class="text-muted small">@ViewHelper.ToDisplay(comment.CreatedAt)</span></div>
                        <div class="pre-line">@comment.Content</div>
                    </li>
                }
            </ul>
        }

        @using (Html.BeginForm("AddComment", "Tasks", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="taskId" value="@Model.Task.TaskId" />
            <div class="form-group">
                <label for="content">Thêm bình luận</label>
                <textarea id="content" name="content" rows="3" maxlength="1000" class="form-control" required="required"></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Gửi bình luận</button>
        }
    </div>

    <div class="col-md-4">
        <dl class="detail-list">
            <dt>Mức ưu tiên</dt>
            <dd><span class="tag" style="background-color:@Model.Task.Priority.ColorCode">@Model.Task.Priority.Name</span></dd>

            <dt>Người thực hiện</dt>
            <dd>@(Model.Task.Assignee != null ? Model.Task.Assignee.FullName : "Chưa giao")</dd>

            <dt>Hạn chót</dt>
            <dd>
                @ViewHelper.ToDisplay(Model.Task.DueDate)
                @if (Model.Task.DueDate.HasValue)
                {
                    <div class="countdown" data-due="@ViewHelper.ToIso(Model.Task.DueDate)" data-done="@(Model.Task.CompletedAt.HasValue ? "1" : "0")"></div>
                }
            </dd>

            <dt>Người tạo</dt>
            <dd>@Model.Task.CreatedBy.FullName</dd>

            <dt>Ngày tạo</dt>
            <dd>@ViewHelper.ToDisplay(Model.Task.CreatedAt)</dd>

            <dt>Hoàn thành lúc</dt>
            <dd>@ViewHelper.ToDisplay(Model.Task.CompletedAt)</dd>
        </dl>
    </div>
</div>
