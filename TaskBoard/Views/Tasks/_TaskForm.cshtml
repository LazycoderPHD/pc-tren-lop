@model TaskBoard.Models.ViewModels.TaskFormViewModel

@Html.HiddenFor(m => m.TaskId)
@Html.HiddenFor(m => m.ProjectId)

<div class="form-group">
    @Html.LabelFor(m => m.Title)
    @Html.TextBoxFor(m => m.Title, new { @class = "form-control", autofocus = "autofocus" })
    @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger" })
</div>
<div class="form-group">
    @Html.LabelFor(m => m.Description)
    @Html.TextAreaFor(m => m.Description, 4, 40, new { @class = "form-control" })
    @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
</div>
<div class="row">
    <div class="col-sm-6 form-group">
        @Html.LabelFor(m => m.ColumnId)
        @Html.DropDownListFor(m => m.ColumnId, Model.ColumnList, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.ColumnId, "", new { @class = "text-danger" })
    </div>
    <div class="col-sm-6 form-group">
        @Html.LabelFor(m => m.PriorityId)
        @Html.DropDownListFor(m => m.PriorityId, Model.PriorityList, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.PriorityId, "", new { @class = "text-danger" })
    </div>
</div>
<div class="row">
    <div class="col-sm-6 form-group">
        @Html.LabelFor(m => m.AssigneeId)
        @Html.DropDownListFor(m => m.AssigneeId, Model.AssigneeList, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.AssigneeId, "", new { @class = "text-danger" })
    </div>
    <div class="col-sm-6 form-group">
        @Html.LabelFor(m => m.DueDate)
        @Html.TextBoxFor(m => m.DueDate, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local" })
        @Html.ValidationMessageFor(m => m.DueDate, "", new { @class = "text-danger" })
    </div>
</div>
