@model TaskBoard.Models.ViewModels.TaskFormViewModel
@{
    ViewBag.Title = "Sửa thẻ";
}
<div class="row">
    <div class="col-md-8">
        <h2>Sửa thẻ</h2>
        <p class="text-muted">Dự án: @Model.ProjectName</p>
        @using (Html.BeginForm("Edit", "Tasks", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            @Html.Partial("_TaskForm", Model)
            <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
            @Html.ActionLink("Hủy", "Details", "Projects", new { id = Model.ProjectId }, new { @class = "btn btn-default" })
        }
    </div>
</div>
@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
