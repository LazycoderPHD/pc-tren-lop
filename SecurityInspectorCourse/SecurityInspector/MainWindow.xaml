<Window x:Class="SecurityInspector.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Windows Security Inspector" Width="1180" Height="780" MinWidth="900" MinHeight="600">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Windows Security Inspector" FontSize="26" FontWeight="Bold" />
            <TextBlock Text="Bài cá nhân • Chỉ đọc cấu hình • Dữ liệu thực hành có nhãn nguồn" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="CancelButton" Content="Hủy tác vụ hiện tại" Padding="12,6" />
            <TextBlock x:Name="StatusText" Text="Sẵn sàng" Margin="12,5,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <TabControl>
            <TabItem Header="Tổng quan">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Button x:Name="RefreshSystemButton" Content="Đọc Windows và Firewall" Padding="10,6" HorizontalAlignment="Left"/>
                    <TextBox x:Name="SystemText" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" Margin="0,10"/>
                    <DataGrid x:Name="FirewallGrid" Grid.Row="2" IsReadOnly="True" AutoGenerateColumns="True"/>
                </Grid>
            </TabItem>
            <TabItem Header="Toàn vẹn tệp">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Thư mục thực hành (không chọn cả ổ cho bài này)"/>
                        <DockPanel>
                            <Button x:Name="ChooseRootButton" Content="Chọn thư mục" DockPanel.Dock="Right"/>
                            <TextBox x:Name="RootText"/>
                        </DockPanel>
                        <TextBlock Text="Baseline JSON (phải nằm ngoài thư mục quét)" Margin="0,8,0,0"/>
                        <TextBox x:Name="BaselineText"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8">
                            <Button x:Name="SaveBaselineButton" Content="Tạo và lưu baseline" Padding="10,6"/>
                            <Button x:Name="CompareButton" Content="Đọc baseline và so sánh" Padding="10,6" Margin="8,0"/>
                        </StackPanel>
                    </StackPanel>
                    <DataGrid x:Name="IntegrityGrid" IsReadOnly="True" AutoGenerateColumns="True"/>
                </DockPanel>
            </TabItem>
            <TabItem Header="EXE mới">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Chọn các ổ cục bộ. Theo dõi trong lúc ứng dụng đang chạy. EXE mới không đồng nghĩa mã độc." TextWrapping="Wrap"/>
                        <Button x:Name="RefreshDrivesButton" Content="Liệt kê ổ đĩa" HorizontalAlignment="Left" Margin="0,8"/>
                        <DataGrid x:Name="DriveGrid" Height="105" AutoGenerateColumns="False" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Chọn" Width="64">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Ổ đĩa" Binding="{Binding Root}" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,8">
                            <Button x:Name="StartExeButton" Content="Bắt đầu giám sát" Padding="10,6"/>
                            <Button x:Name="StopExeButton" Content="Dừng" Padding="10,6" Margin="8,0"/>
                            <Button x:Name="ReconcileButton" Content="Quét đối chiếu" Padding="10,6"/>
                        </StackPanel>
                    </StackPanel>
                    <DataGrid x:Name="ExeGrid" IsReadOnly="True" AutoGenerateColumns="True"/>
                </DockPanel>
            </TabItem>
            <TabItem Header="Nhật ký đăng nhập">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="JSON thực hành, không phải đọc trực tiếp Security Log. Quy tắc lab: ≥5 lần 4625 trong 5 phút, cùng tài khoản/IP." TextWrapping="Wrap"/>
                        <Button x:Name="LoadLogsButton" Content="Chọn log JSON và phân tích" HorizontalAlignment="Left" Padding="10,6" Margin="0,10"/>
                    </StackPanel>
                    <DataGrid x:Name="LogGrid" IsReadOnly="True" AutoGenerateColumns="True"/>
                </DockPanel>
            </TabItem>
            <TabItem Header="Báo cáo">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Báo cáo chứa cả lỗi/phạm vi thiếu dữ liệu. Không phải chứng nhận máy an toàn." TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10">
                            <Button x:Name="ExportJsonButton" Content="Xuất JSON" Padding="10,6"/>
                            <Button x:Name="ExportHtmlButton" Content="Xuất HTML" Padding="10,6" Margin="8,0"/>
                        </StackPanel>
                    </StackPanel>
                    <DataGrid x:Name="ReportGrid" IsReadOnly="True" AutoGenerateColumns="True"/>
                </DockPanel>
            </TabItem>
            <!-- [TABS] -->
        </TabControl>
    </DockPanel>
</Window>